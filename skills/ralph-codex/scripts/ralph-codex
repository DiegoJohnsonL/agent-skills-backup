#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
LIB_DIR = SCRIPT_DIR / "lib"
sys.path.insert(0, str(LIB_DIR))

from prd_parser import load_prd, next_incomplete_task, parse_tasks, summary  # noqa: E402

PROMISE_COMPLETE = "<promise>COMPLETE</promise>"
PINNED_MODEL = "gpt-5.3-codex"
PINNED_REASONING_EFFORT = "high"


@dataclass
class OnceResult:
    promise_complete: bool
    prd_complete: bool
    final_message: str


def run_command(command: list[str], cwd: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, cwd=cwd, check=False, text=True, capture_output=True)


def is_git_repo(repo: str) -> bool:
    proc = run_command(["git", "-C", repo, "rev-parse", "--is-inside-work-tree"])
    return proc.returncode == 0 and proc.stdout.strip() == "true"


def ensure_within_repo(repo: Path, target: Path, label: str) -> None:
    try:
        target.resolve().relative_to(repo.resolve())
    except ValueError as exc:
        raise RuntimeError(f"{label} must be inside repo: {target}") from exc


def load_prompt_contract() -> str:
    contract_path = SCRIPT_DIR.parent / "references" / "prompt-contract.md"
    if not contract_path.is_file():
        raise RuntimeError(f"prompt contract not found: {contract_path}")
    return contract_path.read_text(encoding="utf-8").strip()


def build_prompt(
    *,
    repo: Path,
    prd: Path,
    progress: Path,
    checks: str | None,
    base_branch: str,
    prompt_contract: str,
) -> str:
    checks_line = checks or "pnpm run lint && pnpm run test:unit && pnpm run build"
    return f"""
You are running one isolated Ralph/Codex iteration.

Inputs:
- Source repo root: {repo}
- PRD source-of-truth file: {prd}
- Progress source-of-truth file: {progress}
- Base branch for task worktrees: {base_branch}
- Required checks command: {checks_line}

Follow this prompt contract exactly:
{prompt_contract}

Execution notes:
- You are responsible for worktree/branch setup and all git/gh actions.
- Keep PRD/progress as main-repo source of truth and update intentionally.
- If env or worktree setup fails, fix the workflow and continue.
- Emit {PROMISE_COMPLETE} only when every PRD task is complete.
""".strip()


def stream_events(proc: subprocess.Popen[str], jsonl_path: Path) -> None:
    assert proc.stdout is not None
    with jsonl_path.open("w", encoding="utf-8") as log_file:
        try:
            for line in proc.stdout:
                log_file.write(line)
                log_file.flush()

                stripped = line.strip()
                if not stripped.startswith("{"):
                    continue

                try:
                    event = json.loads(stripped)
                except json.JSONDecodeError:
                    continue

                if event.get("type") != "item.completed":
                    continue

                item = event.get("item", {})
                if item.get("type") != "agent_message":
                    continue

                text = item.get("text", "")
                if text:
                    print(text)
        except KeyboardInterrupt:
            proc.terminate()
            raise


def execute_codex(repo: str, prompt: str, last_msg_path: Path, jsonl_path: Path, stderr_path: Path) -> str:
    cmd = [
        "codex",
        "exec",
        "--model",
        PINNED_MODEL,
        "--config",
        f'model_reasoning_effort="{PINNED_REASONING_EFFORT}"',
        "--ephemeral",
        "--json",
        "--dangerously-bypass-approvals-and-sandbox",
        "-C",
        repo,
        "-o",
        str(last_msg_path),
        "-",
    ]

    with stderr_path.open("w", encoding="utf-8") as stderr_file:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=stderr_file,
            text=True,
        )

        try:
            assert proc.stdin is not None
            proc.stdin.write(prompt)
            proc.stdin.close()

            stream_events(proc, jsonl_path)
            rc = proc.wait()
        except KeyboardInterrupt:
            proc.terminate()
            raise

    if rc != 0:
        stderr_excerpt = stderr_path.read_text(encoding="utf-8")[-4000:]
        raise RuntimeError(f"codex exec failed (exit {rc})\\n{stderr_excerpt}")

    return last_msg_path.read_text(encoding="utf-8").strip() if last_msg_path.exists() else ""


def prd_complete(prd_path: Path) -> bool:
    prd = load_prd(prd_path)
    tasks = parse_tasks(prd)
    return next_incomplete_task(tasks) is None


def has_complete_promise(final_message: str) -> bool:
    # Only honor an exact completion token line to avoid false positives like
    # "Not emitting <promise>COMPLETE</promise>".
    return re.search(r"(?m)^<promise>COMPLETE</promise>$", final_message) is not None


def run_once(args: argparse.Namespace) -> OnceResult:
    repo = Path(args.repo).resolve()
    prd = Path(args.prd).resolve()
    progress = Path(args.progress).resolve()

    if not repo.is_dir():
        raise RuntimeError(f"repo not found: {repo}")
    if not prd.is_file():
        raise RuntimeError(f"PRD not found: {prd}")
    if not progress.exists():
        progress.parent.mkdir(parents=True, exist_ok=True)
        progress.write_text("", encoding="utf-8")
    if not is_git_repo(str(repo)):
        raise RuntimeError("ralph-codex requires a git repository")

    ensure_within_repo(repo, prd, "PRD")
    ensure_within_repo(repo, progress, "progress")
    base_branch = args.base_branch or "main"
    contract = load_prompt_contract()
    prompt = build_prompt(
        repo=repo,
        prd=prd,
        progress=progress,
        checks=args.checks,
        base_branch=base_branch,
        prompt_contract=contract,
    )

    with tempfile.TemporaryDirectory(prefix="ralph-codex-") as tmp:
        tmp_path = Path(tmp)
        final_message = execute_codex(
            repo=str(repo),
            prompt=prompt,
            last_msg_path=tmp_path / "last_message.txt",
            jsonl_path=tmp_path / "events.jsonl",
            stderr_path=tmp_path / "stderr.log",
        )

    complete = prd_complete(prd)
    promise_complete = has_complete_promise(final_message)
    if promise_complete and not complete:
        raise RuntimeError("agent emitted COMPLETE but PRD still has incomplete tasks")

    return OnceResult(
        promise_complete=promise_complete,
        prd_complete=complete,
        final_message=final_message,
    )


def cmd_once(args: argparse.Namespace) -> int:
    result = run_once(args)
    print(
        json.dumps(
            {
                "promise_complete": result.promise_complete,
                "prd_complete": result.prd_complete,
            }
        )
    )
    if result.promise_complete and result.prd_complete:
        print("Ralph complete")
    return 0


def cmd_afk(args: argparse.Namespace) -> int:
    for i in range(1, args.iterations + 1):
        print(f"--- ralph-codex iteration {i}/{args.iterations} ---")
        result = run_once(args)
        print(
            json.dumps(
                {
                    "iteration": i,
                    "promise_complete": result.promise_complete,
                    "prd_complete": result.prd_complete,
                }
            )
        )
        if result.promise_complete and result.prd_complete:
            print(f"PRD complete after {i} iterations")
            return 0

    print("Reached max iterations without completion")
    return 1


def cmd_status(args: argparse.Namespace) -> int:
    prd = load_prd(args.prd)
    tasks = parse_tasks(prd)
    stats = summary(tasks)
    nxt = next_incomplete_task(tasks)
    print(json.dumps(stats))
    if nxt:
        print(f"Next task: {nxt.id} - {nxt.title}")
    return 0


def cmd_doctor(_: argparse.Namespace) -> int:
    script = SCRIPT_DIR / "doctor.sh"
    proc = subprocess.run([str(script)], check=False)
    return proc.returncode


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="ralph-codex")
    sub = parser.add_subparsers(dest="command", required=True)

    def common(p: argparse.ArgumentParser) -> None:
        p.add_argument("--repo", required=True)
        p.add_argument("--prd", required=True)
        p.add_argument("--progress", required=True)
        p.add_argument("--checks")
        p.add_argument("--base-branch")

    once = sub.add_parser("once")
    common(once)
    once.set_defaults(func=cmd_once)

    afk = sub.add_parser("afk")
    common(afk)
    afk.add_argument("--iterations", type=int, required=True)
    afk.set_defaults(func=cmd_afk)

    status = sub.add_parser("status")
    status.add_argument("--repo", required=False)
    status.add_argument("--prd", required=True)
    status.set_defaults(func=cmd_status)

    doctor = sub.add_parser("doctor")
    doctor.set_defaults(func=cmd_doctor)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        return args.func(args)
    except KeyboardInterrupt:
        print("Interrupted by user", file=sys.stderr)
        return 130
    except Exception as exc:  # noqa: BLE001
        print(f"ralph-codex error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
